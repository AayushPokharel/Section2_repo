# Terraform local directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Terraform variable files — may contain secrets
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Plan files
*.tfplan
tfplan
plan.out

# Local environment / secrets
.env
.env.*
*.pem
*.key

# OS files
.DS_Store
Thumbs.db

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

.terraform.lock.hcl

# Revealed step files land in root during class — don't commit them mid-build
/[0-9][0-9]-*.tf
# Never commit secrets
*.auto.tfvars
secrets.tfvars