# Rename to dev.tfvars and update the values as needed for your environment.

environment              = "dev"
location                 = "eastus"
location_short           = "eus"
vm_size                  = "Standard_D2s_v3"
storage_replication_type = "LRS"
mgmt_source_cidr         = "0.0.0.0/0" # replace with <your-public-ip>/32
